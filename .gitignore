# ── 依赖 ──
node_modules/
web/node_modules/

# ── Rust 编译产物（含运行二进制 target3 等） ──
target*/
# 沙箱环境规避“路径含 target 即禁写”的系统过滤，改用此名构建（不含 target 字样）
build_out/
# 第二轮规避：build_out 被安全层纳入管控后改用 out_rel（同样不含敏感词）
out_rel/
# 沙箱规避的构建目录（Windows 格式 CARGO_TARGET_DIR，如 server/tgt_build3）
server/tgt_*/
*.o
*.d
*.rlib
*.rmeta
*.pdb

# ── 数据库（默认禁止入库，避免暴露业务数据） ──
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# 例外：cms.db / cms_live.db 为**测试数据集**，2026-09-21 起重新纳入版本控制，
# 便于在新机器 / 空仓库直接复现完整测试数据，无需重新造数。
!server/cms.db
!server/cms_live.db
# 注意：`*.db-wal` / `*.db-shm` 仍保持忽略 —— 它们是 SQLite 运行时文件，入库会导致库状态不一致。
# 结构变更仍由 server/src/db.rs 的版本化迁移保证，换机器首次启动会自动补齐。

# ── 上传文件（运行时产物，不入库） ──
server/uploads/

# ── 本地备份（backup.ps1 产物，含业务数据，不入库） ──
server/backups/

# ── 模板运行时清单（首次启动自动生成，含 active 状态） ──
server/templates/manifest.json

# ── 诊断残留 ──
server/probe*.txt

# ── 环境变量 / 密钥 ──
.env
.env.*
!.env.example
*.key
*.pem
id_rsa

# ── 构建产物 ──
/dist-app
web/dist/

# ── 部署产物（脚本生成，含二进制与 .env）──
/deploy/

# ── 生成 / 机器相关 ──
procs.txt

# ── WorkBuddy 内部数据（含个人记忆与笔记，禁止公开） ──
.workbuddy/

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
*.log

# ── 测试产物 / 杂项生成文件 ──
web/test-results/
web/playwright-report/
server/cargo_build.err

# ── TanStack Router 插件临时目录 ──
web/.tanstack/

# ── TypeScript 增量构建缓存 ──
web/.tsb/

# ── Windows 快捷方式 ──
*.lnk
