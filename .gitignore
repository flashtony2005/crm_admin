# ── 依赖 ──
node_modules/
web/node_modules/

# ── Rust 编译产物（含运行二进制 target3 等） ──
target*/
*.o
*.d
*.rlib
*.rmeta
*.pdb

# ── 数据库（默认禁止入库，避免暴露业务数据） ──
*.db
*.db-wal
*.sqlite
*.sqlite3
# 例外：仅纳入后端业务库（Turso 本地回退，用户明确选择公开）
!server/cms.db
# 例外：当前实际运行库 server/cms_live.db（从 cms.db 复制解锁后由后端实时读写）
!server/cms_live.db

# ── 环境变量 / 密钥 ──
.env
.env.*
*.key
*.pem
id_rsa

# ── 构建产物 ──
/dist-app
web/dist/

# ── 生成 / 机器相关 ──
procs.txt

# ── WorkBuddy 内部数据（含个人记忆与笔记，禁止公开） ──
.workbuddy/

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
*.log

# ── 测试产物 / 杂项生成文件 ──
web/test-results/
web/playwright-report/
server/cargo_build.err
