target*/
*.o
*.d
*.rlib
*.rmeta
*.pdb

# ── 数据库（含线上 cms_live.db 等，禁止入库） ──
*.db
*.db-wal
*.sqlite
*.sqlite3

# ── 环境变量 / 密钥 ──
.env
.env.*
*.key
*.pem
id_rsa

# ── 构建产物 ──
/dist-app
web/dist/

# ── 生成 / 机器相关 ──
procs.txt

# ── WorkBuddy 内部数据（含个人记忆与笔记，禁止公开） ──
.workbuddy/

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
*.log

# ── 测试产物 / 杂项生成文件 ──
web/test-results/
web/playwright-report/
server/cargo_build.err
