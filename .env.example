# =====================================================================
# coucouya CMS — 环境变量样例（template）
# ---------------------------------------------------------------------
# 用法：
#   1) 复制为 .env：        cp .env.example .env
#   2) 将占位值（含 xxx / your- / change-me / REPLACE 的）替换为真实配置
#   3) 部署前门禁检查：      python3 scripts/check_config.py --env-file .env --strict
#
# 安全：.env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。
# 生产(production)模式会强制要求 JWT_SECRET 且禁止默认值；PUBLIC_BASE_URL 建议 https。
# =====================================================================

# ── 运行模式 ──
# development | production | test
CMS_ENV=development

# ── 服务端口（默认 8088）──
PORT=8088

# ── JWT 签名密钥（必填·生产）──
# 长度 ≥ 16，请使用强随机串，例如：openssl rand -hex 32
# 生产环境若仍为默认值或占位串，启动会被拒绝（A2 安全治理）。
JWT_SECRET=change-me-please-set-a-long-random-secret-string-min-32

# ── 站点对外基址 ──
# 用于 OAuth 回跳 / Stripe 支付成功&取消页 / SEO canonical / 上传资源 CDN 基址。
PUBLIC_BASE_URL=https://cms.example.com

# ── 数据库 ──
# 本地 SQLite（默认）：
DATABASE_URL=sqlite:./cms.db?mode=rwc
# 或 Turso 远程（设置后忽略 DATABASE_URL）：
# TURSO_URL=libsql://your-instance.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── 上传目录（默认 ./uploads）──
# UPLOAD_DIR=./uploads

# ── 静态资源目录（生产内置 SPA 服务，默认 ./dist-app）──
# deploy 会把 web/dist 复制到这里，由 cms-server 直接托管。
# STATIC_DIR=./dist-app

# ── Stripe 付费订阅（缺省进入测试模式，不真实扣费）──
STRIPE_SECRET_KEY=sk_test_xxxREPLACE_WITH_REAL_STRIPE_SECRET_KEYxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxREPLACE_WITH_REAL_WEBHOOK_SECRETxxx

# ── SMTP 邮件（缺省进入测试模式，不真实发送）──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=newsletter@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=newsletter@example.com

# ── AI 能力（可选，缺省关闭）──
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ── 评论审核（可选，默认自动通过）──
# COMMENTS_AUTO_APPROVE=true
